name: Auto-Sync Upstream

on:
  schedule:
    - cron: '0 0 * * *' # Daily at midnight
  workflow_dispatch:

jobs:
  sync:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Configure Git User
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "41898282+github-actions[bot]@users.noreply.github.com"

      - name: Dynamically Find and Add Upstream, Then Sync
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          # Use GitHub CLI to query the API for the parent (upstream) repo clone URL
          UPSTREAM_URL=$(gh repo view ${{ github.repository }} --json parent --jq '.parent.cloneUrl')
          
          if [ "$UPSTREAM_URL" == "null" ] || [ -z "$UPSTREAM_URL" ]; then
            echo "Error: This repository has no parent (it might not be a fork, or it's a private fork)."
            exit 1
          fi
          
          echo "Found upstream URL: $UPSTREAM_URL"
          
          git remote add upstream "$UPSTREAM_URL"
          git fetch upstream --tags --prune
          
          # Push all branches and tags to your fork
          git push origin 'refs/remotes/upstream/*:refs/heads/*' --force
          git push origin --tags --force
